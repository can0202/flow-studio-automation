{
  "name": "flow-studio-automation",
  "version": "3.0.0",
  "description": "Flow Studio Automation - Tự động hoá Google Flow",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "node scripts/build-main.mjs && vite build",
    "dev:renderer": "vite",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "dist": "node scripts/build-main.mjs && vite build && electron-builder --win",
    "dist:portable": "node scripts/build-main.mjs && vite build && electron-builder --win portable",
    "pack": "node scripts/build-main.mjs && vite build && electron-builder --dir"
  },
  "build": {
    "appId": "com.flowstudio.automation",
    "productName": "Flow Studio",
    "copyright": "Copyright © 2025 Flow Studio",
    "afterPack": "scripts/afterPack.mjs",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "release",
      "buildResources": "build-assets"
    },
    "files": [
      "dist/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*",
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-assets/icon.ico",
      "artifactName": "${productName}-v${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Flow Studio",
      "installerIcon": "build-assets/icon.ico",
      "uninstallerIcon": "build-assets/icon.ico",
      "installerHeaderIcon": "build-assets/icon.ico",
      "include": "build-assets/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-v${version}-Portable.exe"
    },
    "asar": true,
    "asarUnpack": [
      "dist/main/assets/**",
      "dist/main/vieneu_server.py",
      "node_modules/better-sqlite3/**",
      "node_modules/bindings/**",
      "node_modules/file-uri-to-path/**",
      "node_modules/playwright/**",
      "node_modules/playwright-core/**"
    ]
  },
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.58.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}